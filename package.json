{
  "name": "semorphe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-components": "npx tsx src/scripts/verify-component-paths.ts",
    "test:e2e": "playwright test",
    "build:vscode": "npx tsx src/scripts/build-vscode.ts",
    "install:ide": "node tools/install-ide.mjs",
    "build:wasm:python": "tree-sitter build --wasm node_modules/tree-sitter-python -o public/tree-sitter-python.wasm"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "happy-dom": "^20.7.0",
    "tree-sitter-cli": "^0.26.6",
    "tree-sitter-cpp": "^0.23.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@blockly/field-multilineinput": "^6.0.8",
    "blockly": "^12.4.1",
    "monaco-editor": "^0.52.2",
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "^0.26.6"
  }
}
