{
  "id": "cpp-beginner",
  "language": "cpp",
  "name": "初學 C++",
  "default": true,
  "description": "適合初學者的漸進式 C++ 概念層級樹，從基礎 I/O 到進階資料結構",
  "levelTree": {
    "id": "L0",
    "level": 0,
    "label": "L0: 基礎",
    "concepts": [
      "print",
      "endl",
      "input",
      "var_declare",
      "var_assign",
      "var_ref",
      "number_literal",
      "string_literal",
      "arithmetic",
      "compare",
      "logic",
      "logic_not",
      "negate",
      "if",
      "if_else",
      "while_loop",
      "builtin_constant",
      "cpp:include",
      "cpp:using_namespace"
    ],
    "children": [
      {
        "id": "L1a",
        "level": 1,
        "label": "L1a: 函式與迴圈",
        "concepts": [
          "func_def",
          "func_call",
          "return",
          "count_loop",
          "cpp:for_loop",
          "cpp:comma_expr",
          "break",
