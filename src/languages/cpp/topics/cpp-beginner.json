              "cpp:strlen",
              "cpp:strcmp",
              "cpp:strcpy",
              "cpp:strcat",
              "cpp:strncpy",
              "cpp:strncmp",
              "cpp:strchr",
              "cpp:strstr",
              "cpp:string_length",
              "cpp:string_substr",
              "cpp:string_find",
              "cpp:string_append",
              "cpp:string_c_str",
              "cpp:string_at",
              "cpp:string_erase",
              "cpp:string_insert",
              "cpp:string_empty",
