    "version": "1.0.0",
    "blockDef": {
      "type": "cpp_func_def",
      "message0": "%{BKY_U_FUNC_DEF_LABEL} %{BKY_U_FUNC_DEF_RETURN_LABEL} %1 %2 %3",
