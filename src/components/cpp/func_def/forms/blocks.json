        {
          "type": "field_input",
          "name": "NAME",
          "text": "main"
        },
        {
          "type": "input_dummy",
          "name": "HEADER"
        }
      ],
      "message1": "%1",
      "args1": [
        {
          "type": "input_statement",
          "name": "BODY",
          "check": "Statement"
        }
      ],
      "previousStatement": "Statement",
      "nextStatement": "Statement",
      "colour": "#FF6680",
      "tooltip": "%{BKY_U_FUNC_DEF_TOOLTIP}",
      "paramList": {
        "itemPattern": "PARAM_{i}",
        "fields": [
          {
            "type": "field_dynamic_dropdown",
            "name": "TYPE_{i}",
            "source": "cpp_param_types"
          },
          {
            "type": "field_input",
            "name": "PARAM_{i}",
            "text": "p{i}"
          },
          {
            "type": "field_label",
            "name": "PARAM_EQ_{i}",
            "text": "＝"
          },
          {
            "type": "field_input",
            "name": "PARAM_DEFAULT_{i}",
            "text": ""
          }
        ],
        "separator": ",",
        "openLabelKey": "U_FUNC_DEF_PARAMS_OPEN",
        "openLabelFallback": "（參數",
        "closeLabelKey": "U_FUNC_DEF_PARAMS_CLOSE",
        "closeLabelFallback": "）",
        "moveTailTo": "BODY",
        "openInput": "PARAMS_LABEL",
        "tailInput": "PARAMS_END",
        "optionalGroups": [
          {
            "key": "default",
