{
  "id": "cpp_block_comment",
  "grammar": "tree-sitter-cpp",
  "astNodeType": "comment",
  "component": {
    "componentId": "cpp:block_comment"
  },
  "constraints": [
    {
      "field": "$text",
      "match": "startsWith",
      "text": "/*"
    }
  ],
  "fieldMappings": [
    {
      "semantic": "text",
      "ast": "$text",
      "extract": "text",
      "transform": "cpp:stripBlockComment"
    }
  ]
}