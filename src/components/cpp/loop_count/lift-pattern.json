{
  "id": "cpp_count_for",
  "grammar": "tree-sitter-cpp",
  "astNodeType": "for_statement",
  "patternType": "composite",
  "component": {
    "componentId": "cpp:loop_count"
  },
  "liftStrategy": "cpp:liftCountFor",
  "composite": {
    "checks": [
      {
        "field": "initializer",
        "typeIs": "declaration"
      },
      {
        "field": "condition",
        "typeIs": "binary_expression"
      },
      {
        "field": "update",
        "typeIs": "update_expression"
      }
    ],
    "extract": {
      "var_name": {
        "source": "path",
        "path": "initializer.init_declarator.declarator"
      },
      "from": {
        "source": "lift",
        "path": "initializer.init_declarator.value"
      },
      "to": {
        "source": "lift",
        "path": "condition.right"
      },
      "body": {
        "source": "liftBody",
        "path": "body"
      }
    }
  },
  "priority": 10
}