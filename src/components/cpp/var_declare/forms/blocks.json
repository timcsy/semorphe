    "blockDef": {
      "type": "cpp_var_declare",
      "message0": "%{BKY_U_VAR_DECLARE_HEADER} %1 %{BKY_U_VAR_DECLARE_VAR_WORD} %2",
      "args0": [
        {
          "type": "field_dynamic_dropdown",
          "name": "TYPE",
