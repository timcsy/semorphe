          "allowCustom": true
        },
        {
          "type": "input_dummy",
          "name": "HEADER"
        }
      ],
      "paramList": {
        "itemPattern": "VAR_{i}",
        "fields": [
          {
            "type": "field_input",
            "name": "NAME_{i}",
            "text": "v{i}",
            "firstText": "x"
          },
          {
            "type": "field_label",
            "name": "VAR_EQ_{i}",
            "text": "="
          }
        ],
        "separator": ",",
        "minCount": 1,
        "openInput": "PARAMS_LABEL",
        "tailInput": "TAIL",
        "optionalGroups": [
          {
            "key": "init",
            "fromField": "VAR_EQ_{i}",
            "labelKey": "U_VAR_DECLARE_INIT_LABEL",
            "labelFallback": "初始值",
            "defaultOpen": true,
            "valueInput": {
              "name": "INIT_{i}",
              "check": "Expression",
              "replacesItem": true
            }
          }
        ],
        "itemsAs": {
          "key": "items",
          "group": "init",
          "open": "var_init",
          "closed": "var"
        }
      },
      "inputsInline": true,
      "previousStatement": "Statement",
      "nextStatement": "Statement",
      "colour": "#FF8C1A",
      "tooltip": "%{BKY_U_VAR_DECLARE_TOOLTIP}"
    },
    "renderMapping": {
      "fields": {},
