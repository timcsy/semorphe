{
  "id": "cpp_delete_expression",
  "grammar": "tree-sitter-cpp",
  "astNodeType": "delete_expression",
  "component": {
    "componentId": "cpp:delete"
  },
  "fieldMappings": [
    {
      "semantic": "ptr",
      "ast": "$namedChildren[0]",
      "extract": "lift"
    },
    {
      "semantic": "is_array",
      "ast": "$text",
      "extract": "text",
      "transform": "cpp:deleteIsArray"
    }
  ]
}
