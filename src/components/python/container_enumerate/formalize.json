{
  "template": {
    "$case": "start_style",
    "cases": {
      "keyword": {
        "k": "eCall",
        "n": "$id",
        "func": {
          "k": "eName",
          "n": "$id/func",
          "id": "enumerate"
        },
        "args": {
          "$slots": "value"
        },
        "keywords": [
          {
            "$ifSlot": "start",
            "then": {
              "k": "keyword",
              "arg": "start",
              "value": {
                "$slot": "start"
              }
            }
          }
        ]
      }
    },
    "else": {
      "k": "eCall",
      "n": "$id",
      "func": {
        "k": "eName",
        "n": "$id/func",
        "id": "enumerate"
      },
      "args": {
        "$slots": "value",
        "$append": [
          {
            "$ifSlot": "start",
            "then": {
              "$slot": "start"
            }
          }
        ]
      },
      "keywords": []
    }
  }
}
