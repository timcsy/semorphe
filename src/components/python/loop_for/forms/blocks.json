[
  {
    "id": "python_loop_for",
    "componentId": "python:loop_for",
    "language": "python",
    "category": "control",
    "version": "1.0.0",
    "blockDef": {
      "type": "python_loop_for",
      "message0": "%{BKY_PYTHON_FOR_MSG0}",
      "args0": [
        {
          "type": "input_value",
          "name": "ITERABLE",
          "check": "Expression"
        }
      ],
      "message1": "%1",
      "args1": [
        {
          "type": "input_statement",
          "name": "BODY",
          "check": "Statement"
        }
      ],
      "inputsInline": true,
      "previousStatement": "Statement",
      "nextStatement": "Statement",
      "colour": "#FFAB19",
      "tooltip": "%{BKY_PYTHON_FOR_TOOLTIP}",
      "paramList": {
        "itemPattern": "PARAM_{i}",
        "fields": [
          {
            "type": "field_input",
            "name": "PARAM_{i}",
            "text": "i"
          }
        ],
        "separator": "，",
        "openLabelKey": "PYTHON_FOR_TARGETS_OPEN",
        "openLabelFallback": "裡的每一個",
        "closeLabelKey": "PYTHON_FOR_TARGETS_CLOSE",
        "closeLabelFallback": "",
        "moveTailTo": "BODY",
        "minCount": 1
      },
      "elseTail": {
        "elseInput": "ELSE_BODY",
        "elseLabelKey": "PYTHON_FOR_ELSE",
        "elseLabelFallback": "沒被中斷就",
        "containerLabelKey": "PYTHON_FOR_MUTATOR_TITLE",
        "containerLabelFallback": "重複",
        "colour": "#FFAB19"
      }
    },
    "renderMapping": {
      "inputs": {
        "ITERABLE": "iterable"
      },
      "statementInputs": {
        "BODY": "body",
        "ELSE_BODY": "else_body"
      },
      "fields": {},
      "dynamicRules": [
        {
          "countSource": "paramCount",
          "childSlot": "targets",
          "childComponent": "param_decl",
          "childFields": {
            "PARAM_{i}": "name"
          }
        }
      ],
      "extraStateFlags": {
        "hasElse": "else_body"
      }
    },
    "_why": "🔴 **`message0` 只准引用 `args0` 裡真的有的那幾格**（2026-08-22）：被綁定的名字是 **paramList 接上去的 input**，不是訊息的引數。標籤曾經寫成「對 %2 裡的每一個 %1」，而 `args0` 只有一格——症狀是這顆積木**完全建不出來**，使用者打開「流程控制」看到 `if` 之後就沒有了。第五十一條護欄在看這件事。\n🔴 **被綁定的名字用 paramList，不是一個文字欄位**（2026-08-21）：`for k, v in d.items():` 有兩個名字，而一個欄位只裝得下一個——症狀是第二個名字在積木來回時**靜默遺失**。\n⚠️ `countSource` 用 `paramCount`，與同族函式定義的參數列一字不差（存檔契約）。",
    "_elseTail_why": "🟢 **`else:` 走齒輪**（第 417 刀）：齒輪裡只有一顆「沒被中斷就」，拖進去積木下面就多一段，與 `if` 的 else 同一種手勢。⚠️ 標籤不寫「否則」：迴圈的 `else` 不是條件不成立，是**迴圈跑完而沒有遇到 `break`**——寫成「否則」學生會讀成「條件一開始就不成立才做」。"
  }
]
