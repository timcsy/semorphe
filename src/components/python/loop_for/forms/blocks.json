[
  {
    "id": "python_loop_for",
    "componentId": "python:loop_for",
    "language": "python",
    "category": "control",
    "version": "1.0.0",
    "blockDef": {
      "type": "python_loop_for",
      "message0": "%{BKY_PYTHON_FOR_MSG0}",
      "args0": [
        {
          "type": "input_value",
          "name": "ITERABLE",
          "check": "Expression"
        }
      ],
      "message1": "%1",
      "args1": [
        {
          "type": "input_statement",
          "name": "BODY",
          "check": "Statement"
        }
      ],
      "inputsInline": true,
      "previousStatement": "Statement",
      "nextStatement": "Statement",
      "colour": "#FFAB19",
      "tooltip": "%{BKY_PYTHON_FOR_TOOLTIP}",
      "paramList": {
        "itemPattern": "PARAM_{i}",
        "fields": [
          {
            "type": "field_input",
            "name": "PARAM_{i}",
            "text": "i"
          }
        ],
        "separator": "，",
        "openLabelKey": "PYTHON_FOR_TARGETS_OPEN",
        "openLabelFallback": "裡的每一個",
        "closeLabelKey": "PYTHON_FOR_TARGETS_CLOSE",
        "closeLabelFallback": "",
        "moveTailTo": "BODY"
      }
    },
    "renderMapping": {
      "inputs": {
        "ITERABLE": "iterable"
      },
      "statementInputs": {
        "BODY": "body"
      },
      "fields": {},
      "dynamicRules": [
        {
          "countSource": "paramCount",
          "childSlot": "targets",
          "childComponent": "param_decl",
          "childFields": {
            "PARAM_{i}": "name"
          }
        }
      ]
    },
    "_why": "🔴 **被綁定的名字用 paramList，不是一個文字欄位**（2026-08-21）：`for k, v in d.items():` 有兩個名字，而一個欄位只裝得下一個——症狀是第二個名字在積木來回時**靜默遺失**。\n⚠️ `countSource` 用 `paramCount`，與同族函式定義的參數列一字不差（存檔契約）。"
  }
]
