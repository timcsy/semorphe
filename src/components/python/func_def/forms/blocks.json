    "blockDef": {
      "type": "python_func_def",
      "message0": "%{BKY_PYTHON_FUNC_DEF_MSG0}",
      "args0": [
        {
          "type": "field_input",
          "name": "NAME",
          "text": "f"
        },
        {
          "type": "field_input",
          "name": "RETURNS",
          "text": ""
        }
      ],
      "message1": "%1",
      "args1": [
        {
          "type": "input_statement",
          "name": "BODY",
          "check": "Statement"
        }
      ],
      "inputsInline": true,
      "previousStatement": "Statement",
      "nextStatement": "Statement",
      "colour": "#FF6680",
      "tooltip": "%{BKY_PYTHON_FUNC_DEF_TOOLTIP}",
      "paramList": {
        "itemPattern": "PARAM_{i}",
        "fields": [
          {
            "type": "field_input",
            "name": "PARAM_{i}",
            "text": "p{i}"
          },
          {
            "type": "field_input",
            "name": "PARAM_TYPE_{i}",
            "text": ""
          },
          {
            "type": "field_input",
            "name": "PARAM_DEFAULT_{i}",
            "text": ""
          }
        ],
        "separator": "，",
        "openLabelKey": "PYTHON_FUNC_DEF_PARAMS_OPEN",
        "openLabelFallback": "（參數",
        "closeLabelKey": "PYTHON_FUNC_DEF_PARAMS_CLOSE",
        "closeLabelFallback": "）",
        "moveTailTo": "BODY"
      }
    },
    "renderMapping": {
      "fields": {
        "NAME": "name",
        "RETURNS": "returns"
      },
      "statementInputs": {
        "BODY": "body"
      },
      "dynamicRules": [
        {
          "countSource": "paramCount",
          "childSlot": "params",
          "childComponent": "param_decl",
          "childFields": {
            "PARAM_{i}": "name",
            "PARAM_TYPE_{i}": "type",
            "PARAM_DEFAULT_{i}": "default"
          }
        }
      ]
    },
    "_why": "🔴 **每一格參數有三個欄位**：名字、型別註記、預設值；而回傳型別是 `RETURNS` 那一格。\n只有名字那一格的話，`def greet(n, greeting=\"你好\")` 在積木來回之後**預設值靜默消失**——而那時產出的程式仍然合法，只是行為不同。\n⚠️ **型別註記那兩格是 2026-08-22 補的，而它是同一個洞的第二次**：抬升與產生都收了 `r: float` 與 `-> float`，**積木上卻沒有那一格**，於是「程式碼→積木→程式碼」把註記吃掉了（開瀏覽器看出來的，測試全綠）。\n> **一個屬性收得進語義樹，卻沒有一格積木裝它——那不是少一個欄位，那是投影會掉東西。**"
  }
]
